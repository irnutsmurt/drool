[Unit]
Description=DROOL (Distributed Remote Operations & Observability Layer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=drool
Group=drool
ExecStart=/usr/local/bin/drool serve
Restart=on-failure
RestartSec=5s

# Data, logs, TLS material and the credential master key live here.
StateDirectory=drool
StateDirectoryMode=0750
ConfigurationDirectory=drool
Environment=DROOL_DATA_DIR=/var/lib/drool

# The controller needs no local privileges.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
