# DROOL with rootless Podman, run by systemd (Quadlet; Podman 4.4 or newer).
#
#   podman pull ghcr.io/irnutsmurt/drool:main     # the image named in Image= below
#   mkdir -p ~/.config/containers/systemd
#   cp drool.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user start drool
#   journalctl --user -u drool -n 30      # the address and the one-time setup code
#   loginctl enable-linger "$USER"        # keep it running after you log out, and start it at boot
#
# The image: as published in DROOL's repository, Image= is DROOL's
# development image from GitHub Container Registry, rebuilt from the newest
# code that passed DROOL's tests (`podman pull` gets the newest). A release
# ships this file with its own version filled in, next to its image file:
# `podman load -i drool_<version>_image.oci.tar` instead of the pull. For an
# image built from a source checkout, Image=docker.io/library/drool:local.
#
# The same restrictions as compose.yaml: read-only, no capabilities,
# no-new-privileges, a tmpfs /tmp, data in the drool-data volume.
[Unit]
Description=DROOL controller (Podman)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=drool
Image=ghcr.io/irnutsmurt/drool:main
# The web interface and the Shepherd endpoint: the first number is the port
# on this machine, the second the one DROOL listens on inside the container.
PublishPort=8080:8080
PublishPort=9443:9443
# Publishing one as another port here, for example PublishPort=2043:9443?
# Then tell DROOL that port too, so it gives Shepherds the right one (and its
# startup message shows the right web port):
#Environment=DROOL_AGENT_PUBLIC_PORT=2043
#Environment=DROOL_SERVER_PUBLIC_PORT=8443
Volume=drool-data:/data
ReadOnly=true
Tmpfs=/tmp
DropCapability=ALL
NoNewPrivileges=true
HealthCmd=/usr/local/bin/drool healthcheck
HealthInterval=30s
HealthStartPeriod=60s
# Shepherds connect to the address you open DROOL with in your browser. If
# your hosts reach this machine by another name or address, name it (the
# Shepherd port is added):
#Environment=DROOL_AGENT_ADVERTISE=drool.example.net

[Service]
Restart=always

[Install]
WantedBy=default.target
